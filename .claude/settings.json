{
  "enabledPlugins": {
    "reliab@reliab": true
  },
  "extraKnownMarketplaces": {
    "reliab": {
      "source": {
        "repo": "hbaldwin98/reliab",
        "source": "github"
      }
    }
  },
  "env": {
    "PYTHONUTF8": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/dev-session-start.sh\"",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(reliab *)"
    ]
  }
}
